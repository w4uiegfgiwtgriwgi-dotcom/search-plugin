    "stage6:check-sources": "powershell -ExecutionPolicy Bypass -File scripts/stage6-check-sources.ps1",
    "api:dev": ".\\.venv\\Scripts\\python.exe scripts/run-fastapi-api.py",
    "api:legacy": "set PYTHONPATH=apps/local-api&& C:\\Users\\Administrator.DESKTOP-P33KF9U\\.cache\\codex-runtimes\\codex-primary-runtime\\dependencies\\python\\python.exe -m vmf_api.server",
