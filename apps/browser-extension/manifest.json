{
  "manifest_version": 3,
  "name": "全网视频素材智能搜索助手",
  "version": "0.1.0",
  "description": "阶段1浏览器扩展骨架：只提供用户主动采集当前页面公开信息的入口。",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:17860/*"],
  "action": { "default_title": "添加到素材助手", "default_popup": "popup.html" },
  "background": { "service_worker": "src/background.js" }
}
